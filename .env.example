# ---------------------------------------------------------------------------
# 2FA Live Code — environment configuration
# ---------------------------------------------------------------------------
#
# The TOTP tool itself is 100% client-side: it has NO backend and needs no
# environment variables at all.
#
# The optional account layer (sign-up / login / admin panel) uses Firebase
# Authentication + Cloud Firestore. Copy this file to `.env.local` (or add the
# variables to your CI secret store) and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app.
#
# Firebase web configuration is *public by design* — it is not a secret and it
# is safe to ship in a browser bundle. What must stay private is the
# Firestore rules (see `firestore.rules`).
#
#   cp .env.example .env.local
#
# ---------------------------------------------------------------------------

# --- Firebase --------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated e-mail addresses that always receive the `admin` role.
# The first account created in a brand new project is promoted automatically.
VITE_FIREBASE_ADMIN_EMAILS=

# --- Deployment ------------------------------------------------------------

# Base path the app is served from.
#   "/"                      -> https://example.com/
#   "/my-repo/"              -> https://<user>.github.io/my-repo/
# Leave empty for local development; the GitHub Actions workflow sets it.
VITE_BASE_URL=

# Set to "1" to enable the verbose in-browser debug overlay in development.
VITE_DEBUG=
